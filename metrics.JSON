{
    "Metrics":{
        "Universe":{
            "In_Index.D":{
                "Description":"S&P 500 Member on Filing Date (Y/N)",
                "Formula":"IN_INDEX",
                "Rounding":"None"
                }
            },
        "Growth":{
            "Sust_G_Rate":{
                "Description":"Sustainable Growth Rate",
                "Formula":"(ROE / 100) * (RET_RATIO / 100) * 100",
                "Rounding":"3"
                },
            "Int_G_Rate":{
                "Description":"Internal Growth Rate",
                "Formula":"(ROA / 100) * (RET_RATIO / 100) * 100",
                "Rounding":"3"
                },
            "EPS_Growth_1Yr":{
                "Description":"Earnings Per Share Growth",
                "Formula":"((EPS.0 - EPS.1) / EPS.1 * 100).where((EPS.0 > 0) & (EPS.1 > 0))",
                "Rounding":"3"
                },
            "SPS_Growth_1Yr":{
                "Description":"Sales Per Share Growth",
                "Formula":"((SPS.0 - SPS.1) / SPS.1 * 100).where((SPS.0 > 0) & (SPS.1 > 0))",
                "Rounding":"3"
                },
            "EPS_CAGR_3Yr":{
                "Description":"Earnings Per Share 3-Year CAGR",
                "Formula":"(((EPS.0 / EPS.3) ** (1/3) - 1) * 100).where((EPS.0 > 0) & (EPS.3 > 0))",
                "Rounding":"3"
                },
            "EPS_CAGR_5Yr":{
                "Description":"Earnings Per Share 5-Year CAGR",
                "Formula":"(((EPS.0 / EPS.5) ** (1/5) - 1) * 100).where((EPS.0 > 0) & (EPS.5 > 0))",
                "Rounding":"3"
                },
            "SPS_CAGR_3Yr":{
                "Description":"Sales Per Share 3-Year CAGR",
                "Formula":"(((SPS.0 / SPS.3) ** (1/3) - 1) * 100).where((SPS.0 > 0) & (SPS.3 > 0))",
                "Rounding":"3"
                },
            "SPS_CAGR_5Yr":{
                "Description":"Sales Per Share 5-Year CAGR",
                "Formula":"(((SPS.0 / SPS.5) ** (1/5) - 1) * 100).where((SPS.0 > 0) & (SPS.5 > 0))",
                "Rounding":"3"
                },
            "CFOPS_CAGR_3Yr":{
                "Description":"Cash Flow from Operations per Share 3-Year CAGR",
                "Formula":"(((CFOPS.0 / CFOPS.3) ** (1/3) - 1) * 100).where((CFOPS.0 > 0) & (CFOPS.3 > 0))",
                "Rounding":"3"
                },
            "CFOPS_CAGR_5Yr":{
                "Description":"Cash Flow from Operations per Share 5-Year CAGR",
                "Formula":"(((CFOPS.0 / CFOPS.5) ** (1/5) - 1) * 100).where((CFOPS.0 > 0) & (CFOPS.5 > 0))",
                "Rounding":"3"
                },
            "FCFPS_CAGR_3Yr":{
                "Description":"Free Cash Flow per Share 3-Year CAGR",
                "Formula":"(((FCF_PS.0 / FCF_PS.3) ** (1/3) - 1) * 100).where((FCF_PS.0 > 0) & (FCF_PS.3 > 0))",
                "Rounding":"3"
                },
            "FCFPS_CAGR_5Yr":{
                "Description":"Free Cash Flow per Share 5-Year CAGR",
                "Formula":"(((FCF_PS.0 / FCF_PS.5) ** (1/5) - 1) * 100).where((FCF_PS.0 > 0) & (FCF_PS.5 > 0))",
                "Rounding":"3"
                },
            "Inv_Rate":{
                "Description":"Rate of Fixed Investment",
                "Formula":"INV_RATE",
                "Rounding":"3"
                },
            "Inv_Rate_3Yr":{
                "Description":"Rate of Fixed Investment 3-Year Average",
                "Formula":"(INV_RATE.0 + INV_RATE.1 + INV_RATE.2) / 3",
                "Rounding":"3"
                },
            "Inv_Rate_5Yr":{
                "Description":"Rate of Fixed Investment 5-Year Average",
                "Formula":"(INV_RATE.0 + INV_RATE.1 + INV_RATE.2 + INV_RATE.3 + INV_RATE.4) / 5",
                "Rounding":"3"
                },
            "CapX_Intensity":{
                "Description":"Capital Expenditures as % of Cash Flow from Operations; NaN if CFO <= 0",
                "Formula":"(CAPX / CFO * 100).where(CFO > 0)",
                "Rounding":"3"
                },
            "Asset_G_Rate":{
                "Description":"Rate of Fixed Asset Growth (YoY Change in Net PP&E)",
                "Formula":"(PPE.0 / PPE.1 - 1) * 100",
                "Rounding":"3"
                },
            "Payout_CAGR_3Yr":{
                "Description":"Common Stock Payout 3-Year CAGR",
                "Formula":"(((COMM_PAYOUT_PS.0 / COMM_PAYOUT_PS.3) ** (1/3) - 1) * 100).where((COMM_PAYOUT_PS.0 > 0) & (COMM_PAYOUT_PS.3 > 0))",
                "Rounding":"3"
                },
            "Payout_CAGR_5Yr":{
                "Description":"Common Stock Payout 5-Year CAGR",
                "Formula":"(((COMM_PAYOUT_PS.0 / COMM_PAYOUT_PS.5) ** (1/5) - 1) * 100).where((COMM_PAYOUT_PS.0 > 0) & (COMM_PAYOUT_PS.5 > 0))",
                "Rounding":"3"
                }
            },
        "Value":{
            "P_E":{
                "Description":"Price to Earnings Ratio",
                "Formula":"Price / EPS",
                "Rounding":"3"
                },
            "P_S":{
                "Description":"Price to Sales Ratio",
                "Formula":"Price / SPS",
                "Rounding":"3"
                },
            "P_B":{
                "Description":"Price to Book Value Ratio",
                "Formula":"Price / BVPS",
                "Rounding":"3"
                },
            "P_CFO":{
                "Description":"Price to Cash Flow from Operations Ratio",
                "Formula":"Price / CFOPS",
                "Rounding":"3"
                },
            "P_FCF":{
                "Description":"Price to Free Cash Flow Ratio",
                "Formula":"Price / FCF_PS",
                "Rounding":"3"
                },
            "EV_EBITDA":{
                "Description":"Enterprise Value to EBITDA Ratio",
                "Formula":"EV / EBITDA",
                "Rounding":"3"
                },
            "EV_CFO":{
                "Description":"Enterprise Value to Cash Flow from Operations Ratio",
                "Formula":"EV / CFO",
                "Rounding":"3"
                }
            },
        "Quality":{
            "ROE":{
                "Description":"Return on Equity",
                "Formula":"EARN_COMM / AVG_COMM * 100",
                "Rounding":"3"
                },
            "ROE_3Yr":{
                "Description":"Return on Equity 3-Year Average",
                "Formula":"(ROE.0 + ROE.1 + ROE.2) / 3",
                "Rounding":"3"
                },
            "ROE_5Yr":{
                "Description":"Return on Equity 5-Year Average",
                "Formula":"(ROE.0 + ROE.1 + ROE.2 + ROE.3 + ROE.4) / 5",
                "Rounding":"3"
                },
            "EBITDA_MGN":{
                "Description":"EBITDA Margin",
                "Formula":"EBITDA / REV * 100",
                "Rounding":"3"
                },
            "EBITDA_MGN_3Yr":{
                "Description":"EBITDA Margin 3-Year Average",
                "Formula":"(EBITDA_MGN.0 + EBITDA_MGN.1 + EBITDA_MGN.2) / 3",
                "Rounding":"3"
                },
            "EBITDA_MGN_5Yr":{
                "Description":"EBITDA Margin 5-Year Average",
                "Formula":"(EBITDA_MGN.0 + EBITDA_MGN.1 + EBITDA_MGN.2 + EBITDA_MGN.3 + EBITDA_MGN.4) / 5",
                "Rounding":"3"
                },
            "CFO_MGN":{
                "Description":"Cash Flow from Operations Margin",
                "Formula":"CFO / REV * 100",
                "Rounding":"3"
                },
            "CFO_MGN_3Yr":{
                "Description":"Cash Flow from Operations Margin 3-Year Average",
                "Formula":"(CFO_MGN.0 + CFO_MGN.1 + CFO_MGN.2) / 3",
                "Rounding":"3"
                },
            "CFO_MGN_5Yr":{
                "Description":"Cash Flow from Operations Margin 5-Year Average",
                "Formula":"(CFO_MGN.0 + CFO_MGN.1 + CFO_MGN.2 + CFO_MGN.3 + CFO_MGN.4) / 5",
                "Rounding":"3"
                },
            "FCF_MGN":{
                "Description":"Free Cash Flow Margin",
                "Formula":"FCF / REV * 100",
                "Rounding":"3"
                },
            "FCF_MGN_3Yr":{
                "Description":"Free Cash Flow Margin 3-Year Average",
                "Formula":"(FCF_MGN.0 + FCF_MGN.1 + FCF_MGN.2) / 3",
                "Rounding":"3"
                },
            "FCF_MGN_5Yr":{
                "Description":"Free Cash Flow Margin 5-Year Average",
                "Formula":"(FCF_MGN.0 + FCF_MGN.1 + FCF_MGN.2 + FCF_MGN.3 + FCF_MGN.4) / 5",
                "Rounding":"3"
                },
            "DEBT_EQ":{
                "Description":"Debt to Equity Ratio",
                "Formula":"TOT_DEBT / EQUITY * 100",
                "Rounding":"3"
                },
            "EPS_Var_5Yr":{
                "Description":"Earnings Per Share 5-Year Variability (Std Dev of YoY EPS Growth, %); NaN if any EPS <= 0 in window",
                "Formula":"STDV((EPS.0 / EPS.1 - 1) * 100, (EPS.1 / EPS.2 - 1) * 100, (EPS.2 / EPS.3 - 1) * 100, (EPS.3 / EPS.4 - 1) * 100, (EPS.4 / EPS.5 - 1) * 100).where(MIN(EPS.0, EPS.1, EPS.2, EPS.3, EPS.4, EPS.5) > 0)",
                "Rounding":"3"
                },
            "Payout_YLD":{
                "Description":"Common Stock Payout Yield",
                "Formula":"PAYOUT_YLD",
                "Rounding":"3"
                },
            "Payout_YLD_3Yr":{
                "Description":"Common Stock Payout Yield 3-Year Average",
                "Formula":"(PAYOUT_YLD.0 + PAYOUT_YLD.1 + PAYOUT_YLD.2) / 3",
                "Rounding":"3"
                },
            "Payout_YLD_5Yr":{
                "Description":"Common Stock Payout Yield 5-Year Average",
                "Formula":"(PAYOUT_YLD.0 + PAYOUT_YLD.1 + PAYOUT_YLD.2 + PAYOUT_YLD.3 + PAYOUT_YLD.4) / 5",
                "Rounding":"3"
                },
            "Payout_Ratio":{
                "Description":"Common Stock Payout Ratio",
                "Formula":"PAY_RATIO",
                "Rounding":"3"
                },
            "FCF_Payout_Ratio":{
                "Description":"Free Cash Flow Payout Ratio",
                "Formula":"COMM_PAYOUT / FCF * 100",
                "Rounding":"3"
                }
            },
            "Momentum":{
                "6M_Return":{
                    "Description":"6-Month Price Return",
                    "Formula":"(Price - Price_6M_Ago) / Price_6M_Ago * 100",
                    "Rounding":"3"
                    },
                "12M_Return":{
                    "Description":"12-Month Price Return",
                    "Formula":"(Price - Price_12M_Ago) / Price_12M_Ago * 100",
                    "Rounding":"3"
                    },
                "24M_Return":{
                    "Description":"24-Month Price Return",
                    "Formula":"(Price - Price_24M_Ago) / Price_24M_Ago * 100",
                    "Rounding":"3"
                    },
                "SP_12M_Return":{
                    "Description":"SP500 12-Month Price Return",
                    "Formula":"(SP_Price - SP_12M_Ago) / SP_12M_Ago * 100",
                    "Rounding":"3"
                    },
                "12M_Excess_Return":{
                    "Description":"12-Month Excess Price Return",
                    "Formula":"EXCESS_RET_12M",
                    "Rounding":"3"
                    },
                "12M_Excess_Return_3Yr":{
                    "Description":"12-Month Excess Price Return 3-Year Average",
                    "Formula":"(EXCESS_RET_12M.0 + EXCESS_RET_12M.1 + EXCESS_RET_12M.2) / 3",
                    "Rounding":"3"
                    },
                "12M_Excess_Return_5Yr":{
                    "Description":"12-Month Excess Price Return 5-Year Average",
                    "Formula":"(EXCESS_RET_12M.0 + EXCESS_RET_12M.1 + EXCESS_RET_12M.2 + EXCESS_RET_12M.3 + EXCESS_RET_12M.4) / 5",
                    "Rounding":"3"
                    }
            },
        "Forward":{
            "Fwd_Return_1Yr.Y":{
                "Description":"Forward 1-Year Total Return, Annualized (Backtest Label; Uses Future Prices)",
                "Formula":"FWD_RET_1Y",
                "Rounding":"3"
                },
            "Fwd_Return_3Yr.Y":{
                "Description":"Forward 3-Year Total Return, Annualized (Backtest Label; Uses Future Prices)",
                "Formula":"FWD_RET_3Y",
                "Rounding":"3"
                },
            "Fwd_Return_5Yr.Y":{
                "Description":"Forward 5-Year Total Return, Annualized (Backtest Label; Uses Future Prices)",
                "Formula":"FWD_RET_5Y",
                "Rounding":"3"
                },
            "Fwd_Excess_Return_1Yr.Y":{
                "Description":"Forward 1-Year Annualized Total Return less S&P 500 (SPY) Annualized Total Return (Backtest Label)",
                "Formula":"FWD_RET_1Y - SPY_FWD_RET_1Y",
                "Rounding":"3"
                },
            "Fwd_Excess_Return_3Yr.Y":{
                "Description":"Forward 3-Year Annualized Total Return less S&P 500 (SPY) Annualized Total Return (Backtest Label)",
                "Formula":"FWD_RET_3Y - SPY_FWD_RET_3Y",
                "Rounding":"3"
                },
            "Fwd_Excess_Return_5Yr.Y":{
                "Description":"Forward 5-Year Annualized Total Return less S&P 500 (SPY) Annualized Total Return (Backtest Label)",
                "Formula":"FWD_RET_5Y - SPY_FWD_RET_5Y",
                "Rounding":"3"
                }
            }
        },
    "Fields":{
        "ASSETS":{
            "Description":"Total Assets",
            "Source":"BS",
            "API":"totalAssets",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "AVG_ASSETS":{
            "Description":"Average Total Assets",
            "Source":"Formula",
            "API":"None",
            "Formula":"(ASSETS.0 + ASSETS.1) / 2",
            "Rounding":"None"
        },
        "EQUITY":{
            "Description":"Total Shareholder Equity",
            "Source":"BS",
            "API":"totalStockholdersEquity",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "PREF":{
            "Description":"Preferred Equity",
            "Source":"BS",
            "API":"preferredStock",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "COMM":{
            "Description":"Common Equity",
            "Source":"Formula",
            "API":"None",
            "Formula":"EQUITY - PREF",
            "Rounding":"None"
        },
        "AVG_COMM":{
            "Description":"Average Common Equity",
            "Source":"Formula",
            "API":"None",
            "Formula":"(COMM.0 + COMM.1) / 2",
            "Rounding":"None"
        },
        "SHARES":{
            "Description":"Weighted Avg Diluted Shares (TTM Average)",
            "Source":"IS",
            "API":"weightedAverageShsOutDil",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "SHARES_END":{
            "Description":"Period-End Shares (Diluted Weighted Avg of Final Quarter)",
            "Source":"IS",
            "API":"weightedAverageShsOutDil",
            "Aggregation":"Quarter",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "BVPS":{
            "Description":"Book Value Per Common Share",
            "Source":"Formula",
            "API":"None",
            "Formula":"COMM / SHARES_END",
            "Rounding":"3"
        },
        "REV":{
            "Description":"Revenue",
            "Source":"IS",
            "API":"revenue",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "CFO":{
            "Description":"Cash Flow from Operations",
            "Source":"CF",
            "API":"operatingCashFlow",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "FCF":{
            "Description":"Free Cash Flow",
            "Source":"Formula",
            "API":"None",
            "Formula":"CFO - CAPX",
            "Rounding":"None"
        },
        "CFOPS":{
            "Description":"Cash Flow from Operations per Share",
            "Source":"Formula",
            "API":"None",
            "Formula":"CFO / SHARES",
            "Rounding":"3"
        },
        "FCF_PS":{
            "Description":"Free Cash Flow per Share",
            "Source":"Formula",
            "API":"None",
            "Formula":"FCF / SHARES",
            "Rounding":"3"
        },
        "EARN":{
            "Description":"Earnings",
            "Source":"IS",
            "API":"netIncome",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "PREF_DIV":{
            "Description":"Preferred Dividends",
            "Source":"CF",
            "API":"preferredDividendsPaid",
            "Formula":"/ -1_000_000",
            "Rounding":"None"
        },
        "COMM_DIV":{
            "Description":"Dividends Paid",
            "Source":"CF",
            "API":"commonDividendsPaid",
            "Formula":"/ -1_000_000",
            "Rounding":"None"
        },
        "EARN_COMM":{
            "Description":"Earnings to Common",
            "Source":"Formula",
            "API":"None",
            "Formula":"EARN - PREF_DIV",
            "Rounding":"None"
        },
        "EPS":{
            "Description":"Earnings Per Share Diluted",
            "Source":"Formula",
            "API":"None",
            "Formula":"EARN_COMM / SHARES",
            "Rounding":"3"
        },
        "SPS":{
            "Description":"Sales Per Share",
            "Source":"Formula",
            "API":"None",
            "Formula":"REV / SHARES",
            "Rounding":"3"
        },
        "ROE":{
            "Description":"Return on Equity",
            "Source":"Formula",
            "API":"None",
            "Formula":"EARN_COMM / AVG_COMM * 100",
            "Rounding":"3"
        },
        "ROA":{
            "Description":"Return on Assets",
            "Source":"Formula",
            "API":"None",
            "Formula":"EARN / AVG_ASSETS * 100",
            "Rounding":"3"
        },
        "EBITDA":{
            "Description":"Earnings Before Interest, Taxes, Depreciation and Amortization",
            "Source":"IS",
            "API":"ebitda",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "EBITDA_MGN":{
            "Description":"EBITDA Margin",
            "Source":"Formula",
            "API":"None",
            "Formula":"EBITDA / REV * 100",
            "Rounding":"3"
        },
        "CFO_MGN":{
            "Description":"Cash Flow from Operations Margin",
            "Source":"Formula",
            "API":"None",
            "Formula":"CFO / REV * 100",
            "Rounding":"3"
        },
        "FCF_MGN":{
            "Description":"Free Cash Flow Margin",
            "Source":"Formula",
            "API":"None",
            "Formula":"FCF / REV * 100",
            "Rounding":"3"
        },
        "NET_STOCK_REPURCHASES":{
            "Description":"Common Stock Repurchases",
            "Source":"CF",
            "API":"netCommonStockIssuance",
            "Formula":"/ -1_000_000",
            "Rounding":"None"
        },
        "COMM_PAYOUT":{
            "Description":"Common Stock Payout",
            "Source":"Formula",
            "API":"None",
            "Formula":"COMM_DIV + NET_STOCK_REPURCHASES",
            "Rounding":"None"
        },
        "COMM_PAYOUT_PS":{
            "Description":"Common Stock Payout per Share",
            "Source":"Formula",
            "API":"None",
            "Formula":"COMM_PAYOUT / SHARES",
            "Rounding":"3"
        },
        "PAY_RATIO":{
            "Description":"Total Payout Ratio (Dividends + Net Buybacks) to Common",
            "Source":"Formula",
            "API":"None",
            "Formula":"COMM_PAYOUT / EARN_COMM * 100",
            "Rounding":"3"
        },
        "RET_RATIO":{
            "Description":"Retention Ratio (1 - Total Payout Ratio)",
            "Source":"Formula",
            "API":"None",
            "Formula":"(1 - PAY_RATIO / 100) * 100",
            "Rounding":"3"
        },
        "CAPX":{
            "Description":"Capital Expenditures",
            "Source":"CF",
            "API":"capitalExpenditure",
            "Formula":"/ -1_000_000",
            "Rounding":"None"
        },
        "PPE":{
            "Description":"Property, Plant & Equipment",
            "Source":"BS",
            "API":"propertyPlantEquipmentNet",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "MKT_CAP":{
            "Description":"Market Capitalization",
            "Source":"Formula",
            "API":"None",
            "Formula":"Price * SHARES_END",
            "Rounding":"None"
        },
        "NET_DEBT":{
            "Description":"Total Debt less Cash & Cash Equivalents",
            "Source":"BS",
            "API":"netDebt",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "TOT_DEBT":{
            "Description":"Total Debt",
            "Source":"BS",
            "API":"totalDebt",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "MINORITY_INT":{
            "Description":"Minority Interest",
            "Source":"BS",
            "API":"minorityInterest",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "EV":{
            "Description":"Enterprise Value",
            "Source":"Formula",
            "API":"None",
            "Formula":"MKT_CAP + NET_DEBT + PREF + MINORITY_INT",
            "Rounding":"None"
        },
        "COMM_STOCK":{
            "Description":"Common Stock",
            "Source":"BS",
            "API":"commonStock",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "APIC":{
            "Description":"Additional Paid-In Capital",
            "Source":"BS",
            "API":"additionalPaidInCapital",
            "Formula":"/ 1_000_000",
            "Rounding":"None"
        },
        "INV_CAP":{
            "Description":"Invested Capital (Common Stock)",
            "Source":"Formula",
            "API":"None",
            "Formula":"COMM_STOCK + APIC",
            "Rounding":"None"
        },
        "PAYOUT_YLD":{
            "Description":"Common Stock Payout Yield",
            "Source":"Formula",
            "API":"None",
            "Formula":"COMM_PAYOUT / ((MKT_CAP.1 + MKT_CAP.0) / 2) * 100",
            "Rounding":"3"
        },
        "INV_RATE":{
            "Description":"Rate of Fixed Investment (Capex / Average Total Assets)",
            "Source":"Formula",
            "API":"None",
            "Formula":"CAPX / AVG_ASSETS * 100",
            "Rounding":"3"
        },
        "Price":{
            "Description":"Average Close Price, 3 Trading Days Following Filing Date",
            "Source":"Price",
            "API":"None",
            "Formula":"None",
            "Rounding":"3"
        },
        "Price_6M_Ago":{
            "Description":"Average Close, 3 Trading Days Following Date ~6 Months Before Filing Date",
            "Source":"PriceLookback",
            "API":"6",
            "Formula":"None",
            "Rounding":"3"
        },
        "Price_12M_Ago":{
            "Description":"Average Close, 3 Trading Days Following Date ~12 Months Before Filing Date",
            "Source":"PriceLookback",
            "API":"12",
            "Formula":"None",
            "Rounding":"3"
        },
        "Price_24M_Ago":{
            "Description":"Average Close, 3 Trading Days Following Date ~24 Months Before Filing Date",
            "Source":"PriceLookback",
            "API":"24",
            "Formula":"None",
            "Rounding":"3"
        },
        "SP_Price":{
            "Description":"S&P 500 Avg Close, 3 Trading Days Following Filing Date",
            "Source":"Price",
            "API":"None",
            "Symbol":"^GSPC",
            "Formula":"None",
            "Rounding":"3"
        },
        "SP_6M_Ago":{
            "Description":"S&P 500 Average Close, 3 Trading Days Following Date ~6 Months Before Filing Date",
            "Source":"PriceLookback",
            "API":"6",
            "Symbol":"^GSPC",
            "Formula":"None",
            "Rounding":"3"
        },
        "SP_12M_Ago":{
            "Description":"S&P 500 Average Close, 3 Trading Days Following Date ~12 Months Before Filing Date",
            "Source":"PriceLookback",
            "API":"12",
            "Symbol":"^GSPC",
            "Formula":"None",
            "Rounding":"3"
        },
        "SP_24M_Ago":{
            "Description":"S&P 500 Average Close, 3 Trading Days Following Date ~24 Months Before Filing Date",
            "Source":"PriceLookback",
            "API":"24",
            "Symbol":"^GSPC",
            "Formula":"None",
            "Rounding":"3"
        },
        "IN_INDEX":{
            "Description":"S&P 500 Member on Filing Date (Y/N), Point-in-Time",
            "Source":"Membership",
            "API":"None",
            "Formula":"None",
            "Rounding":"None"
        },
